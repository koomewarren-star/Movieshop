# ─────────────────────────────────────────────────────────────
# MovieShop — environment configuration
# Copy to `.env.local` and fill in your own keys.
# ─────────────────────────────────────────────────────────────

# TMDB API key (v3). Free: https://www.themoviedb.org/settings/api
# Note: a NEXT_PUBLIC_* value is inlined into the browser bundle.
# TMDB keys are designed to be public, but treat this as non-secret anyway.
NEXT_PUBLIC_TMDB_API_KEY=""

# Optional TMDB v4 read access token, used server-side as a Bearer header.
# Prefer keeping this un-prefixed so it is never sent to the browser.
TMDB_BEARER_TOKEN=""

# NexStream embed key used to build player URLs.
# Falls back to the shared demo key when empty.
NEXT_PUBLIC_NEXSTREAM_KEY="DEMO_36bed89b"

# Playback provider on first load: "nexstream", "vidsrc", "autoembed" or "cc".
#   cc        - openly-licensed open movies (Blender, CC BY). No ads, but it
#               plays substitute footage, labelled in the player.
# The viewer can switch between them in the player header; the choice is saved
# in localStorage and overrides this default.
NEXT_PUBLIC_PLAYBACK_PROVIDER="autoembed"

